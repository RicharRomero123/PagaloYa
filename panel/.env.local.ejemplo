# Copia este archivo como `.env.local` y llena los valores.
#
# Se sacan de: consola Firebase → ⚙ Configuración del proyecto → Tus apps →
# app web (si no existe, créala con "Agregar app" → Web).
#
# Estos valores NO son secretos: viajan dentro del bundle del navegador. Lo que
# protege los datos son las reglas de Firestore, no ocultar esta configuración.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
