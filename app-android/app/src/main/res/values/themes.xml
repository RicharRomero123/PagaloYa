<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo crema desde el primer frame para que no haya flash blanco al abrir.
         Iconos oscuros en la barra de estado porque el fondo es claro. -->
    <style name="Theme.PagoYa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/crema</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/crema</item>
    </style>

    <!-- Splash: se ve solo durante el arranque en frío; MainActivity vuelve a
         Theme.PagoYa con setTheme() antes de dibujar Compose. -->
    <style name="Theme.PagoYa.Splash">
        <item name="android:statusBarColor">@color/naranja_pagoya</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/splash_pagoya</item>
    </style>
</resources>
