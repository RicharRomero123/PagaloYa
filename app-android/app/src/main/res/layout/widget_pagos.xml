<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de inicio "la bolsa de PagoYa": total de hoy + últimos 5 pagos.
  RemoteViews puro (sin librerías). Toca el widget → abre la app.
  La mascota a color va en la cabecera (el widget sí admite PNG a color).
  Compatible con API 24: nada de paddingHorizontal/Vertical (API 26+); se usan
  paddingLeft/Right/Top/Bottom, que son los que RemoteViews infla sin fallar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_widget"
    android:padding="14dp">

    <!-- Cabecera: mascota + marca + total de hoy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/mascota_extraida"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu caja de hoy"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOY"
                android:textColor="#99FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 0.00"
                android:textColor="@color/naranja_pagoya"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <!-- Estado vacío -->
    <TextView
        android:id="@+id/widget_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:text="Aún no cae nada, casero"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Contenedor de filas -->
    <LinearLayout
        android:id="@+id/widget_lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fila 1 -->
        <LinearLayout
            android:id="@+id/fila_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fondo_fila_pago"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fila_1_billetera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/blanco"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/fila_1_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textColor="@color/naranja_pagoya"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fila 2 -->
        <LinearLayout
            android:id="@+id/fila_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fondo_fila_pago"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fila_2_billetera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/blanco"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/fila_2_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textColor="@color/naranja_pagoya"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fila 3 -->
        <LinearLayout
            android:id="@+id/fila_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fondo_fila_pago"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fila_3_billetera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/blanco"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/fila_3_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textColor="@color/naranja_pagoya"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fila 4 -->
        <LinearLayout
            android:id="@+id/fila_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fondo_fila_pago"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fila_4_billetera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/blanco"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/fila_4_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textColor="@color/naranja_pagoya"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fila 5 -->
        <LinearLayout
            android:id="@+id/fila_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fondo_fila_pago"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fila_5_billetera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/blanco"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/fila_5_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textColor="@color/naranja_pagoya"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
