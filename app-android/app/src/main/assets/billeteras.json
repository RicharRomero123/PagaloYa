{
  "version": 2,
  "_nota": "Mismo esquema que usa Firebase Remote Config (parámetro billeteras_json). Grupo 1 = nombre del pagador, grupo 2 = monto. Los textos reales de cada billetera se afinan con el modo aprendizaje.",
  "_nota_voz": "vozPlantillaSinNombre es la que se usa POR DEFECTO: no dice el nombre del pagador (dato personal gritado en público, Ley 29733). vozPlantilla solo se usa si el comercio activa 'Decir el nombre' en Más > La voz de tu caja.",
  "billeteras": [
    {
      "id": "yape",
      "nombre": "Yape",
      "paquetes": ["com.bcp.innovacxion.yapeapp"],
      "patrones": [
        "(?i)(.+?)\\s+te\\s+yape[oó]\\s+S\\/\\.?\\s*([0-9]+(?:[.,][0-9]{1,2})?)",
        "(?i)recibiste\\s+un\\s+pago\\s+de\\s+(.+?)\\s+por\\s+S\\/\\.?\\s*([0-9]+(?:[.,][0-9]{1,2})?)",
        "(?i)(.+?)\\s+te\\s+envi[oó]\\s+un\\s+pago\\s+por\\s+S\\/\\.?\\s*([0-9]+(?:[.,][0-9]{1,2})?)",
        "(?i)¡?te\\s+yapearon!?\\s*(.+?)\\s+te\\s+envi[oó]\\s+S\\/\\.?\\s*([0-9]+(?:[.,][0-9]{1,2})?)"
      ],
      "vozPlantillaSinNombre": "¡Pago Ya! Te yapearon {monto}",
      "vozPlantilla": "¡Pago Ya! {nombre} te yapeó {monto}"
    },
    {
      "id": "plin-interbank",
      "nombre": "Plin",
      "paquetes": ["pe.com.interbank.mobilebanking"],
      "patrones": [
        "(?i)(.+?)\\s+te\\s+(?:ha\\s+)?pline(?:[oó]|ado)\\s+S\\/\\.?\\s*([0-9]+(?:[.,][0-9]{1,2})?)",
        "(?i)recibiste\\s+un\\s+plin\\s+de\\s+(.+?)\\s+por\\s+S\\/\\.?\\s*([0-9]+(?:[.,][0-9]{1,2})?)"
      ],
      "vozPlantillaSinNombre": "¡Pago Ya! Pago Plin de {monto}",
      "vozPlantilla": "¡Pago Ya! Pago Plin de {monto} de {nombre}"
    }
  ]
}
