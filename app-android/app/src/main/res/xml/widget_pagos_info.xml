<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadatos del App Widget de PagoYa. updatePeriodMillis = 30 min (mínimo real
  de Android); el refresco inmediato al caer un pago lo dispara RegistroPagos
  vía WidgetPagos.refrescar(). Toca el widget → abre la app.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="250dp"
    android:targetCellWidth="3"
    android:targetCellHeight="5"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_pagos"
    android:previewImage="@drawable/mascota_extraida"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
