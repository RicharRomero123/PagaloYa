    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Cuerpo del parlantito con carita y rejilla recortadas (evenOdd) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4.4,4.4
            l7.0,0
            a1.8,1.8 0 0 1 1.8,1.8
            l0,11.6
            a1.8,1.8 0 0 1 -1.8,1.8
            l-7.0,0
            a1.8,1.8 0 0 1 -1.8,-1.8
            l0,-11.6
            a1.8,1.8 0 0 1 1.8,-1.8
